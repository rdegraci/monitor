    "command": "rsync-server",
    "needs_tty": false,
    "expansion": "function _rsync_server() { [ -z \"$1\" ] && return; rsync -avz ./ \"${RSYNC_SERVER_TARGET:?RSYNC_SERVER_TARGET not set}/$1\"; }; _rsync_server",
    "description": "expansion: shell function; requires RSYNC_SERVER_TARGET environment variable (e.g. user@host:base_path)"
  },
  {
    "command": "scp-server",
    "needs_tty": false,
    "expansion": "function _scp_server() { [ -z \"$1\" ] && return; scp -r ./ \"${SCP_SERVER_TARGET:?SCP_SERVER_TARGET not set}/$1\"; }; _scp_server",
    "description": "expansion: shell function to SCP current directory to a server location; requires SCP_SERVER_TARGET env var"
  },
