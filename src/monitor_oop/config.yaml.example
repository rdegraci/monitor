# Default model used by the assistant.
model: openai/gpt-5.4-mini

# Default token budget / context window.
context_window: 400000

# Default logging verbosity.
logging_level: INFO

# Prompt history settings.
history_dir: history
prompt_history_filename: prompt_history

# Summarization settings used by the compaction flow.
summarization:
  token_limit: 4000
  prompt_template: Summarize the conversation history concisely while preserving important context, decisions, constraints, and open tasks.
